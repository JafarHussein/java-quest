{
  // Kill all automatic suggestion popups & ghost text
  "editor.quickSuggestions": {
    "comments": "off",
    "strings": "off",
    "other": "off"
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.inlineSuggest.enabled": false,
  "editor.wordBasedSuggestions": "off",
  "editor.acceptSuggestionOnEnter": "off",

  // Kill parameter hints & hover tooltips (reduces distraction)
  "editor.parameterHints.enabled": false,
  "editor.hover.enabled": "off",

  // Java: keep the language server's completion engine on
  // so Ctrl+Space still works for imports when you need it
  "java.completion.enabled": true,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable"
}   